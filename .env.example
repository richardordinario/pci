# Copy to .env.local for local testing; set the same variables in Vercel → Settings → Environment Variables.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Inbox that receives the form (comma-separated for several)
CONTACT_TO_EMAIL=info@pcitech.com.ph
# Sender on a domain verified in Resend. Leave empty to use Resend's test sender while testing.
CONTACT_FROM_EMAIL=PCI Website <website@pcitech.com.ph>
